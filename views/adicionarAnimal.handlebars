<div class="container">
    <h2>Adicionar Novo Animal</h2>
    <form method="POST" action="/animais">
        <label for="especie">Especie:</label>
        <input type="text" id="especie" name="especie" placeholder="Digite a especie" required>
        <label for="quantidade">Quantidade:</label>
        <input type="number" id="quantidade" name="quantidade" placeholder="Digite a especie" required>
        <label for="habitate">Habitate:</label>
        <input type="text" id="habitate" name="habitate" placeholder="Digite a especie" required>
        <button type="submit">Adicionar</button>
    </form>
</div>